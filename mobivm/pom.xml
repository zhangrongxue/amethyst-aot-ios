<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.mcjava</groupId>
  <artifactId>mcjava-aot</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>mcjava-aot</name>
  <description>
    MobiVM/RoboVM AOT payload: a Minecraft-version-manifest style preflight that is
    compiled ahead of time to a native binary. Used to prove the AOT toolchain and the
    forceLinkClasses configuration generated by reflect-scan.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
    <robovm.version>2.3.23</robovm.version>
    <gson.version>2.10.1</gson.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.mobidevelop.robovm</groupId>
      <artifactId>robovm-rt</artifactId>
      <version>${robovm.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>mcjava-aot</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>dev.mcjava.aot.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <mainClass>dev.mcjava.aot.Main</mainClass>
        </configuration>
      </plugin>

      <plugin>
        <groupId>com.mobidevelop.robovm</groupId>
        <artifactId>robovm-maven-plugin</artifactId>
        <version>${robovm.version}</version>
        <configuration>
          <configFile>${project.basedir}/robovm.xml</configFile>
          <arch>${robovm.arch}</arch>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
